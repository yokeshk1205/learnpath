# Browser-facing development configuration
VITE_API_BASE_URL=/api
VITE_ML_BASE_URL=/ml

# Node API
NODE_ENV=development
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://learnpath:learnpath@localhost:5432/learnpath
DATABASE_SSL=false
ML_SERVICE_URL=http://127.0.0.1:8000
ML_SERVICE_TIMEOUT_MS=5000

# Authentication — replace before use; use at least 32 random characters
AUTH_ACCESS_TOKEN_SECRET=replace-with-at-least-32-random-characters
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_REFRESH_COOKIE_NAME=learnpath_refresh

# Retention decay — exponential daily forgetting rate before confidence/evidence adjustment
RETENTION_BASE_LAMBDA=0.025

# ML service
ML_PORT=8000
MODEL_DIRECTORY=./services/ml/models
SYNTHETIC_DATA_DIRECTORY=./services/ml/data/synthetic
FEATURE_DATA_DIRECTORY=./services/ml/data/features
EXPERIMENT_DIRECTORY=./services/ml/models/benefit-ranking-v1

# PostgreSQL container
POSTGRES_DB=learnpath
POSTGRES_USER=learnpath
POSTGRES_PASSWORD=learnpath
