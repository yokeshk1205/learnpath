{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LearnPath: Configure local environment",
      "type": "npm",
      "script": "setup:local",
      "problemMatcher": []
    },
    {
      "label": "LearnPath: Install Python dependencies",
      "type": "npm",
      "script": "setup:python",
      "problemMatcher": []
    },
    {
      "label": "LearnPath: Run full stack",
      "type": "npm",
      "script": "dev:local",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "LearnPath: Run database migrations",
      "type": "npm",
      "script": "db:migrate",
      "problemMatcher": []
    },
    {
      "label": "LearnPath: Start with Docker",
      "type": "shell",
      "command": "docker compose up --build",
      "options": {"cwd": "${workspaceFolder}"},
      "problemMatcher": []
    }
  ]
}
